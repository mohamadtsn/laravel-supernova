{
    "name": "mohamadtsn/laravel-supernova",
    "description": "it's a basic Management panel for laravel application",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "laravel-supernova", "laravel10-package", "laravel11-package", "PHP", "laravel10", "laravel11", "admin-panel", "laravel admin", "laravel-metronic", "laravel-admin-panel"],
    "homepage": "https://github.com/mohamadtsn/laravel-supernova",
    "authors": [
        {
            "name": "Mohammad Borzoyi",
            "email": "mohamad.borzoyi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "illuminate/auth": "^10.0|^11.0",
        "spatie/laravel-permission": "^5.10|^6.0",
        "biscolab/laravel-recaptcha": "^6.0|^7.0",
        "realrashid/sweet-alert": "^7.0",
        "mohamadtsn/laravel-repository": "^2.0|^3.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Mohamadtsn\\Supernova\\": "src/"
        },
        "files": [
            "src/Tools/helpers.php"
        ]
    } ,
    "extra": {
        "laravel": {
            "providers": [
                "Mohamadtsn\\Supernova\\SupernovaServiceProvider",
                "Mohamadtsn\\Supernova\\Classes\\Notifications\\SweetAlert\\SupernovaSweetAlertServiceProvider"
            ],
            "aliases": {
                "Supernova": "Mohamadtsn\\Supernova\\Facade\\Supernova",
                "Menu": "Mohamadtsn\\Supernova\\Facade\\Menu",
                "SupernovaSweetAlert": "Mohamadtsn\\Supernova\\Classes\\Notifications\\SweetAlert\\Facades\\SupernovaSweetAlert"
            }
        }
    }
}
